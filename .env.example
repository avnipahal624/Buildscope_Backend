# ---- Database (matches docker-compose.yml) ----
DATABASE_URL=postgresql+psycopg://buildscope:buildscope@localhost:5432/buildscope

# ---- TinyFish (https://agent.tinyfish.ai/api-keys) ----
TINYFISH_API_KEY=

# ---- LLM (any OpenAI-compatible chat API) ----
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Embeddings (leave key/base blank to reuse the LLM ones) ----
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ---- Limits (cost control) ----
MAX_SOURCES_PER_RUN=12
MAX_QUERIES_PER_RUN=5
